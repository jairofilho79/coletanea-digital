# Database Configuration - Production
POSTGRES_USER=coletanea_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
POSTGRES_DB=coletanea_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://coletanea_user:CHANGE_THIS_PASSWORD_IN_PRODUCTION@localhost:5433/coletanea_db

# API Configuration - Production
API_PORT=8001
ENVIRONMENT=prod

# CORS - Production (RESTRITIVO: apenas domínios específicos)
# IMPORTANTE: Configure com os domínios reais de produção
CORS_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

# Future: JWT Configuration (for auth features)
# JWT_SECRET_KEY=CHANGE_THIS_TO_STRONG_SECRET_IN_PRODUCTION
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
