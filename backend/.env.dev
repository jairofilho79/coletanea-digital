# Database Configuration - Development
POSTGRES_USER=coletanea_user
POSTGRES_PASSWORD=coletanea_password
POSTGRES_DB=coletanea_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://coletanea_user:coletanea_password@localhost:5433/coletanea_db

# API Configuration - Development
API_PORT=8001
ENVIRONMENT=dev

# CORS - Development (permissivo para desenvolvimento local)
CORS_ORIGINS=http://localhost:8080,http://localhost,http://localhost:50000,http://127.0.0.1:8080

# Future: JWT Configuration (for auth features)
# JWT_SECRET_KEY=dev-secret-key-here
