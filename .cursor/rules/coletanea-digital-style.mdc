### Input (TextField)
```dart
TextField(
  style: const TextStyle(
    color: Color(0xFF1A1A1A), // Texto preto ao digitar - OBRIGATÓRIO
  ),
  decoration: InputDecoration(
    labelText: 'Nome da lista',
    labelStyle: const TextStyle(
      color: Colors.white, // Label branco se sobre fundo escuro
      // OU Color(0xFF1A1A1A) se sobre fundo claro
    ),
    hintText: 'Ex: Louvores de domingo',
    hintStyle: const TextStyle(
      color: Color(0xFF5A5A5A), // Placeholder cinza escuro
    ),
    labelStyle: const TextStyle(
      color: Color(0xFF5A5A5A), // Label cinza escuro quando dentro do input
    ),
    floatingLabelStyle: const TextStyle(
      color: Color(0xFF5A5A5A), // Label cinza escuro quando flutuando
    ),
    filled: true,
    fillColor: const Color(0xFFF5E6D3), // Fundo bege
    border: OutlineInputBorder(
      borderRadius: BorderRadius.circular(12),
      borderSide: const BorderSide(
        color: Color(0xFFD4AF37), // Borda dourada
        width: 2,
      ),
    ),
    enabledBorder: OutlineInputBorder(
      borderRadius: BorderRadius.circular(12),
      borderSide: const BorderSide(
        color: Color(0xFFD4AF37),
        width: 2,
      ),
    ),
    focusedBorder: OutlineInputBorder(
      borderRadius: BorderRadius.circular(12),
      borderSide: const BorderSide(
        color: Color(0xFFF4D03F), // Dourado claro quando focado
        width: 2,
      ),
    ),
  ),
)
```

